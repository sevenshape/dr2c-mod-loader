{
  "name": "dr2c-mod-loader",
  "version": "0.0.1",
  "description": "Load mod to dr2c.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "pip install frida && pip install frida-tools",
    "which": "which frida-compile && frida-compile --version && which frida && frida --version",
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist');fs.cpSync('assets','dist/assets',{recursive:true});fs.cpSync('index.js','dist/index.js');fs.cpSync('index.html','dist/index.html');fs.cpSync('package.json','dist/package.json');\" && frida-compile index.js -o dist/main.js",
    "build:package": "npm run build && node utils/pack.js",
    "dev": "npm run build && python utils/run.py",
    "dev:package": "npm run build:package && python utils/run.py",
    "dev:android": "npm run build && python utils/run-android.py com.noodlecake.drtc",
    "dev:android:package": "npm run build:package && cross-var adb push ./build/%npm_package_name%-%npm_package_version%.zip /storage/emulated/0/ && python utils/run-android.py com.noodlecake.drtc"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.1.0",
    "cross-var": "^1.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "frida-fs": "^7.0.0",
    "frida-java-bridge": "^7.0.13",
    "i18next": "^26.2.0",
    "jszip": "^3.10.1",
    "lzma-native": "^8.0.6",
    "undici": "^8.3.0",
    "xregexp": "^5.1.2"
  }
}
